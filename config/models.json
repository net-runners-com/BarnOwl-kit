{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "BarnOwl 経由で利用可能な Claude モデル一覧。リクエストの model フィールドに指定する。",
  "defaultModel": "sonnet",
  "models": [
    {
      "id": "sonnet",
      "label": "Sonnet（推奨・日常利用）",
      "aliases": ["default"],
      "contextWindow": 200000,
      "recommendedFor": ["chat", "coding", "cursor"]
    },
    {
      "id": "opus",
      "label": "Opus（高難度・推論）",
      "contextWindow": 200000,
      "recommendedFor": ["complex-reasoning", "architecture"]
    },
    {
      "id": "haiku",
      "label": "Haiku（最速・軽量）",
      "contextWindow": 200000,
      "recommendedFor": ["quick-tasks", "summaries"]
    },
    {
      "id": "fable",
      "label": "Fable（最高性能・現在は Fable 5.1）",
      "aliases": ["claude-fable-5-1"],
      "contextWindow": 200000,
      "recommendedFor": ["hardest-reasoning", "frontier"]
    },
    {
      "id": "claude-sonnet-4-6",
      "label": "Claude Sonnet 4.6",
      "contextWindow": 200000,
      "recommendedFor": ["coding"]
    },
    {
      "id": "claude-opus-4-8",
      "label": "Claude Opus 4.8",
      "contextWindow": 200000,
      "recommendedFor": ["complex-tasks"]
    },
    {
      "id": "claude-sonnet-5",
      "label": "Claude Sonnet 5",
      "contextWindow": 200000,
      "recommendedFor": ["latest-sonnet"]
    },
    {
      "id": "claude-sonnet-5[1m]",
      "label": "Claude Sonnet 5（1M コンテキスト）",
      "contextWindow": 1000000,
      "recommendedFor": ["long-context", "coding"]
    },
    {
      "id": "claude-opus-5",
      "label": "Claude Opus 5（最新 Opus）",
      "contextWindow": 200000,
      "recommendedFor": ["latest-opus", "complex-reasoning"]
    },
    {
      "id": "claude-opus-5[1m]",
      "label": "Claude Opus 5（1M コンテキスト）",
      "contextWindow": 1000000,
      "recommendedFor": ["long-context", "complex-reasoning"]
    },
    {
      "id": "claude-fable-5-1",
      "label": "Claude Fable 5.1（最新 Fable）",
      "contextWindow": 200000,
      "recommendedFor": ["hardest-reasoning", "frontier"]
    },
    {
      "id": "default",
      "label": "Claude Code デフォルト",
      "contextWindow": 200000,
      "recommendedFor": ["fallback"]
    },
    {
      "id": "codex",
      "label": "OpenAI Codex（既定 gpt-5.6-terra・ChatGPTログイン）",
      "aliases": ["gpt-5.6-terra"],
      "engine": "codex",
      "provider": "openai",
      "contextWindow": 272000,
      "recommendedFor": ["coding", "openai"]
    },
    {
      "id": "gpt-5.6-terra",
      "label": "Codex gpt-5.6-terra（Codex CLI 既定・バランス型）",
      "engine": "codex",
      "provider": "openai",
      "contextWindow": 272000,
      "recommendedFor": ["coding"]
    },
    {
      "id": "gpt-5.6-luna",
      "label": "Codex gpt-5.6-luna（高速・低コスト）",
      "engine": "codex",
      "provider": "openai",
      "contextWindow": 272000,
      "recommendedFor": ["coding", "simple-tasks"]
    },
    {
      "id": "gpt-5.5",
      "label": "Codex gpt-5.5（前世代）",
      "engine": "codex",
      "provider": "openai",
      "contextWindow": 272000,
      "recommendedFor": ["coding"]
    }
  ],
  "effortLevels": {
    "codex-gpt-5.6-terra": ["none", "low", "medium", "high", "xhigh", "max", "ultra"],
    "codex-gpt-5.6-luna": ["none", "low", "medium", "high", "xhigh", "max"],
    "codex-gpt-5.5": ["none", "low", "medium", "high", "xhigh"],
    "codex-legacy": ["minimal", "low", "medium", "high"],
    "claude": ["low", "medium", "high", "xhigh", "max"],
    "howToSet": "リクエストの reasoning_effort フィールド、または model に ':<effort>' を付与（例: 'gpt-5.5:high', 'sonnet:high'）。Codex 系はモデルごとに自動クランプ（上限超えは最上位へ、minimal→none）。ultra は gpt-5.6-terra 専用（max＋自動タスク委譲）。Claude 系は範囲外の値を無視して既定 effort で動く",
    "verbosity": "Codex 系のみ: リクエストの verbosity フィールド（low|medium|high）が -c model_verbosity に渡る",
    "samplingParams": "temperature / top_p / stop は Claude 系のみ実際に効く（CLAUDE_CODE_EXTRA_BODY 注入・thinking 自動オフ）。Codex 系はバックエンドが拒否するため無視"
  },
  "deprecatedIds": [
    "claude-sonnet-4-20250514",
    "claude-opus-4-20250514",
    "claude-3-5-haiku-20241022",
    "claude-fable-5",
    "gpt-5.6-sol",
    "gpt-5.4",
    "gpt-5.4-mini"
  ],
  "deprecatedNote": "Claude 旧 id は /v1/models に表示されるが CLI が拒否することがある。claude-fable-5 は無害なプロンプトでも safeguards 拒否が返る（2026-09-18 確認）ため fable / claude-fable-5-1 を使うこと。gpt-5.6-sol / gpt-5.4 / gpt-5.4-mini は ChatGPT アカウントでは 400（not supported）。"
}
